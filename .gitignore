# --- Секреты ------------------------------------------------------------
# Ключ OpenAI. Основное место хранения — хранилище паролей Windows,
# но файл может остаться с разработки.
.env
.env.local
*.key

# --- Окружение и сборка -------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Данные ученика -----------------------------------------------------
# База с прогрессом и память учителя. Включая служебные файлы SQLite:
# при включённом журнале рядом с базой лежат ещё два (-wal и -shm).
data/
!data/.gitkeep

# --- Мусор редакторов и системы -----------------------------------------
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# --- Прочее -------------------------------------------------------------
*.log
.pytest_cache/
